<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Thông báo hoá đơn mới / nhắc trả / xác nhận (Android 13+ xin lúc chạy) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Kết nối Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quét QR bằng camera (thư viện quét tự xin) và chụp ảnh hoá đơn (xin trước khi mở camera) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Lưu ảnh QR trên Android 8–9; Android 10+ dùng MediaStore, không cần quyền -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+: được hỏi Zalo có cài không, để nút "Gửi qua Zalo" mở thẳng Zalo -->
    <queries>
        <package android:name="com.zing.zalo" />
    </queries>

    <application
        android:name=".ChiaBillApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChiaBill"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".ui.CreateGroupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.GroupDetailActivity" android:exported="false" />
        <activity android:name=".ui.BillEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.BillDetailActivity" android:exported="false" />
        <activity android:name=".ui.DebtDetailActivity" android:exported="false" />
        <activity android:name=".ui.SettleActivity" android:exported="false" />
        <activity android:name=".ui.QrSetupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Cho máy quét QR xoay dọc -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />

        <!-- Thông báo đẩy Firebase (FCM) khi app đang tắt -->
        <service
            android:name=".util.ChiaBillMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="debts" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
