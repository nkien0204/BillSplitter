<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:subtitleTextColor="@color/muted"
        app:title="Khoản nợ" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/billLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/qrCard"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qrCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/qr"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Mã VietQR chuyển khoản, số tiền đã điền sẵn" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingVertical="4dp">
                        <TextView android:text="Ngân hàng" android:textColor="@color/muted" />
                        <TextView android:id="@+id/bank" android:gravity="end" android:textColor="@color/ink" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:gravity="center_vertical" android:paddingVertical="4dp">
                        <TextView android:text="Số tài khoản" android:textColor="@color/muted" />
                        <TextView android:id="@+id/account" android:fontFeatureSettings="tnum" android:gravity="end" android:textColor="@color/ink" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:paddingVertical="4dp">
                        <TextView android:text="Chủ tài khoản" android:textColor="@color/muted" />
                        <TextView android:id="@+id/holder" android:gravity="end" android:textColor="@color/ink" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:paddingVertical="4dp">
                        <TextView android:text="Nội dung" android:textColor="@color/muted" />
                        <TextView android:id="@+id/content" android:gravity="end" android:textColor="@color/ink" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reveal"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hiện đủ số tài khoản" />

                <TextView
                    android:id="@+id/qrWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_note"
                    android:backgroundTint="@color/warn_bg"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="10dp"
                    android:text="Trước khi bấm chuyển, đối chiếu tên người nhận mà app ngân hàng hiện ra."
                    android:textColor="@color/warn_fg"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashed"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/noQrTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bạn vẫn thấy đúng số tiền. Khi người nhận khai QR, mã có sẵn số tiền sẽ hiện ở đây."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/remindQr"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/debtorActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveQr"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Lưu ảnh QR" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copy"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Sao chép" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markPaid"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tôi đã chuyển" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/creditorConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispute"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Chưa nhận được"
                    android:textColor="@color/err_fg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Đã nhận tiền" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/creditorPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/remind"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/share"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Gửi QR qua…" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cashConfirm"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/ink"
                    android:text="Đã nhận (tiền mặt)"
                    android:textColor="@color/paper" />
            </LinearLayout>

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_note"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:padding="14dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/togglePayload"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Xem chuỗi VietQR (chi tiết kỹ thuật)"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/payload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.3"
                android:padding="12dp"
                android:textColor="@color/brand_on_dark"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
