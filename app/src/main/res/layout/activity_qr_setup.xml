<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:title="QR nhận tiền" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Mở app ngân hàng, chụp màn hình mã QR nhận tiền của bạn, rồi chọn ảnh đó ở đây. Hoặc quét trực tiếp bằng camera của một máy khác đang hiện mã."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickImage"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Chọn ảnh QR" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanCamera"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Quét camera" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resultOk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_note"
                android:backgroundTint="@color/ok_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đọc được VietQR"
                    android:textColor="@color/ok_fg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFeatureSettings="tnum"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/ok_fg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/useResult"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dùng QR này" />
            </LinearLayout>

            <TextView
                android:id="@+id/resultError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_note"
                android:backgroundTint="@color/err_bg"
                android:lineSpacingMultiplier="1.2"
                android:padding="14dp"
                android:textColor="@color/err_fg"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showManual"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cách khác: nhập số tài khoản" />

            <LinearLayout
                android:id="@+id/manualSection"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/bank"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <EditText
                    android:id="@+id/accountNo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:fontFeatureSettings="tnum"
                    android:hint="Số tài khoản"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="19" />

                <EditText
                    android:id="@+id/accountName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Tên chủ tài khoản (không dấu, tuỳ chọn)"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="50" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveManual"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lưu" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Xoá QR nhận tiền"
                android:textColor="@color/err_fg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
