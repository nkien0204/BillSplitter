# Sao chép thành .env rồi điền giá trị từ Firebase console → Project settings → Your apps → Web app.
# Các giá trị EXPO_PUBLIC_* được đóng gói vào app; chúng không phải bí mật.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Chạy với Firebase Emulator Suite (npm run emulators). Android emulator: 10.0.2.2; iOS simulator: localhost;
# điện thoại thật: IP LAN của máy tính.
EXPO_PUBLIC_USE_EMULATOR=false
EXPO_PUBLIC_EMULATOR_HOST=localhost
