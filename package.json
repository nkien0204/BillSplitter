{
  "name": "chiabill",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:domain": "jest src/domain",
    "test:int": "firebase emulators:exec --only auth,firestore --project demo-chiabill \"jest --config jest.int.config.js --runInBand --forceExit\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chiabill"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-media-library": "~58.0.10",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "firebase": "^13.0.0",
    "react": "19.3.0",
    "react-native": "^0.88.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "firebase-tools": "^14.27.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  }
}
