{
  "name": "chiabill-backend",
  "version": "1.0.0",
  "description": "Backend for ChiaBill expense splitting app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "sequelize-cli db:migrate && node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:perf": "node test/perf/load.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "uuid": "^9.0.1",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
