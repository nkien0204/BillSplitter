# Backend environment variables (Render: Dashboard > your service > Environment).
# Locally you can use config/config.json instead; an environment variable wins.

# Port to listen on (Render sets this itself).
PORT=3000
# Any long random string. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# Supabase > Project Settings > Database > Connection string > URI (pooler, port 6543).
# When empty, the server uses SQLite from config/config.json.
DATABASE_URL=
# Supabase > Project Settings > API: project URL and the service_role key.
# When empty, photos are stored in backend/uploads (lost on a free host restart).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public Storage bucket for photos.
SUPABASE_BUCKET=chiabill
